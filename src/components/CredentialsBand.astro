---
/**
 * Dark credentials band — the trust anchor. Text credentials in a brass-ruled
 * row; official logos/badges (when supplied) sit as light "plates" alongside.
 */
import Badge from './Badge.astro';
import { getCredentials } from '../lib/site';
import { reg } from '../lib/text';

interface Props { label: string }
const { label } = Astro.props;
const all = await getCredentials();
const items = all.filter((c) => c.data.show_in_band);
const badges = all.filter((c) => c.data.badge_image || c.data.badge_embed);
---
<section class="cred-band on-ink" aria-labelledby="cred-band-title">
  <div class="container container--wide">
    <div class="cred-band__head">
      <h2 id="cred-band-title" class="cred-band__label">{label}</h2>
      {badges.length > 0 && <div class="cred-band__badges">{badges.map((c) => <Badge credential={c} size="sm" />)}</div>}
    </div>
    <ul role="list" class="cred-band__grid" style={`--count:${items.length}`}>
      {
        items.map((c, i) => (
          <li class="credential" data-reveal style={`--reveal-delay:${i * 60}ms`}>
            <span class="credential__issuer">{c.data.issuer}</span>
            <span class="credential__title" set:html={reg(c.data.title)} />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .cred-band {
    position: relative;
    background: var(--ink);
    color: var(--on-ink);
    padding-block: clamp(2.75rem, 2rem + 2.5vw, 4.25rem);
  }

  .cred-band__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding-bottom: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    margin-bottom: clamp(1.5rem, 1rem + 1.5vw, 2.5rem);
    border-bottom: 1px solid var(--brass-line);
  }

  .cred-band__label {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--brass);
  }

  .cred-band__label::before {
    content: '';
    width: 2.25rem;
    height: 1px;
    background: var(--brass);
  }

  .cred-band__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .cred-band__grid {
    display: grid;
    grid-template-columns: 1fr;
  }

  .cred-band__grid > li {
    padding-block: 1.1rem;
    border-top: 1px solid rgb(168 135 90 / 0.22);
  }

  .cred-band__grid > li:first-child {
    border-top: 0;
    padding-top: 0;
  }

  @media (min-width: 40em) {
    .cred-band__grid {
      grid-template-columns: 1fr 1fr;
      column-gap: 2rem;
    }
    .cred-band__grid > li:nth-child(2) {
      border-top: 0;
      padding-top: 0;
    }
  }

  @media (min-width: 64em) {
    .cred-band__grid {
      grid-template-columns: repeat(3, 1fr);
      column-gap: 0;
      row-gap: 2.25rem;
    }
    .cred-band__grid > li {
      padding: 0 1.75rem;
      border-top: 0;
      border-left: 1px solid var(--brass-line);
    }
    .cred-band__grid > li:nth-child(3n + 1) {
      padding-left: 0;
      border-left: 0;
    }
  }

</style>
