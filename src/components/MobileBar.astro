---
/** Persistent bottom "Call" + "Inquire" bar on phones (< 48em). */
import { getSettings, telHref } from '../lib/site';
const settings = await getSettings();
---
<nav class="mobile-bar" aria-label="Quick contact">
  <a class="mobile-bar__call" href={telHref(settings)}>
    <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" focusable="false"><path d="M6.6 2.5 4.2 3.2c-.9.3-1.4 1.2-1.2 2.1 1.6 6.1 5.6 10.1 11.7 11.7.9.2 1.8-.3 2.1-1.2l.7-2.4-3.6-1.9-1.6 1.6c-2.3-1-4.2-2.9-5.2-5.2l1.6-1.6L6.6 2.5Z" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round"></path></svg>
    Call <span class="sr-only">{settings.phone_display}</span>
  </a>
  <a class="mobile-bar__inquire" href="/contact/#inquiry">
    <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" focusable="false"><rect x="2.5" y="4.5" width="15" height="11" fill="none" stroke="currentColor" stroke-width="1.25"></rect><path d="m3 5 7 6 7-6" fill="none" stroke="currentColor" stroke-width="1.25"></path></svg>
    Inquire
  </a>
</nav>

<style>
  .mobile-bar {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 40;
    display: grid;
    grid-template-columns: 1fr 1fr;
    padding-bottom: env(safe-area-inset-bottom);
    background: var(--ink);
    box-shadow: 0 -1px 0 rgb(168 135 90 / 0.5);
  }

  .mobile-bar a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    min-height: var(--bar-h);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .mobile-bar__call {
    color: var(--on-ink);
  }

  .mobile-bar__inquire {
    color: var(--ink);
    background: var(--ivory);
  }

  .mobile-bar a:focus-visible {
    outline: 2px solid var(--brass);
    outline-offset: -4px;
  }

  @media (min-width: 48em) {
    .mobile-bar {
      display: none;
    }
  }
</style>
