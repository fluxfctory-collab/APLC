---
/**
 * Base layout — document head (SEO, social, icons, fonts, structured data),
 * skip link, header, footer, mobile action bar and review banner.
 */
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import ReviewBanner from '../components/ReviewBanner.astro';
import { getSettings, getReviewMode } from '../lib/site';
import { stripMarkers } from '../lib/confirm';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  image?: string;
  imageAlt?: string;
  schema?: Record<string, unknown>[];
  /** Extra font file to preload (e.g. the italic used in a hero headline). */
  preloadItalic?: boolean;
}

const { title, description, noindex = false, image, imageAlt, schema = [], preloadItalic = false } = Astro.props;
const settings = await getSettings();
const review = await getReviewMode();

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const shareImage = new URL(image ?? settings.default_share_image, Astro.site).href;
const shareAlt = imageAlt ?? `${settings.attorney_name}, ${settings.header_tagline} — ${settings.address.city}, ${settings.address.state}`;
const cleanTitle = stripMarkers(title);
const cleanDescription = stripMarkers(description);
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{cleanTitle}</title>
    <meta name="description" content={cleanDescription} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#f7f3ec" />
    <meta name="format-detection" content="telephone=no" />

    <!-- Display serif only: body text has a metric-matched fallback, and CSS is
         inlined so the body font is discovered immediately anyway. -->
    <link rel="preload" href="/fonts/cormorant-garamond-latin-500-normal.woff2" as="font" type="font/woff2" crossorigin />
    {preloadItalic && <link rel="preload" href="/fonts/cormorant-garamond-latin-500-italic.woff2" as="font" type="font/woff2" crossorigin />}

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={settings.firm_name} />
    <meta property="og:title" content={cleanTitle} />
    <meta property="og:description" content={cleanDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={shareAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={cleanTitle} />
    <meta name="twitter:description" content={cleanDescription} />
    <meta name="twitter:image" content={shareImage} />

    <script is:inline>document.documentElement.classList.add('js');</script>
    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <MobileBar />
    {review && <ReviewBanner />}

    <script>
      // Reveal-on-scroll: opacity/translate only, once per element.
      const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -6% 0px', threshold: 0.06 },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-in'));
      }
    </script>
  </body>
</html>

<style is:global>
  main:focus {
    outline: none;
  }

  @media print {
    .site-header,
    .mobile-bar,
    .review-banner,
    .menu {
      display: none !important;
    }
    [data-reveal] {
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>
