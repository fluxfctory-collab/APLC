---
/** Layout for Privacy and Disclaimer pages. */
import { getEntry, render } from 'astro:content';
import Base from './Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { simpleBreadcrumb } from '../lib/schema';

interface Props { id: 'privacy' | 'disclaimer' }
const entry = (await getEntry('legal', Astro.props.id))!;
const { Content } = await render(entry);
const path = `/${Astro.props.id}/`;
const schema = await simpleBreadcrumb(entry.data.title, path);
---
<Base title={entry.data.seo.title} description={entry.data.seo.description} schema={schema}>
  <PageHeader eyebrow="Legal" title={entry.data.title} crumbs={[{ name: entry.data.title, href: path }]}>
    <p class="legal-updated">Last updated {entry.data.updated}</p>
  </PageHeader>
  <section class="section legal">
    <div class="container">
      <div class="prose legal__body">
        <Content />
      </div>
    </div>
  </section>
</Base>

<style>
  .legal-updated {
    margin-top: 1.25rem;
    font-size: 0.875rem;
    color: var(--slate);
  }
  .legal__body :global(h2) {
    font-size: var(--step-2);
  }
</style>
