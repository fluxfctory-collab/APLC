---
/** Home */
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import CredentialsBand from '../components/CredentialsBand.astro';
import Approach from '../components/home/Approach.astro';
import PracticeIndex from '../components/PracticeIndex.astro';
import SectionMarker from '../components/SectionMarker.astro';
import Pillars from '../components/home/Pillars.astro';
import Quote from '../components/home/Quote.astro';
import CtaBand from '../components/CtaBand.astro';
import Arrow from '../components/Arrow.astro';
import { inline } from '../lib/text';
import { homeSchema } from '../lib/schema';

const home = (await getEntry('home', 'home'))!.data;
const schema = await homeSchema();
---

<Base title={home.seo.title} description={home.seo.description} schema={schema} preloadItalic={home.hero.headline.includes('*')}>
  <Hero hero={home.hero} />
  <CredentialsBand label={home.credentials_band.label} />
  <Approach intro={home.intro} />

  <section class="section section--paper practice-preview defer-render" aria-labelledby="practice-title">
    <div class="container">
      <div class="practice-preview__head">
        <div>
          <SectionMarker num="02" label={home.practice_preview.label} />
          <h2 id="practice-title" class="title" set:html={inline(home.practice_preview.heading)} data-reveal />
        </div>
        <p class="lead practice-preview__intro" data-reveal>{home.practice_preview.intro}</p>
      </div>
      <PracticeIndex />
      <div class="practice-preview__foot">
        <p class="practice-preview__note">
          <span class="practice-preview__note-rule" aria-hidden="true"></span>
          <span>{home.practice_preview.custody_note} <a class="link" href="/practice-areas/#custody">About this policy</a></span>
        </p>
        <a class="text-link" href="/practice-areas/">{home.practice_preview.link_label} <Arrow /></a>
      </div>
    </div>
  </section>

  <Pillars pillars={home.pillars} />
  <Quote quote={home.quote} />
  <CtaBand heading={home.closing_cta.heading} body={home.closing_cta.body} buttonLabel={home.closing_cta.button_label} />
</Base>

<style>
  .practice-preview {
    border-top: 1px solid var(--line);
  }

  .practice-preview__head {
    display: grid;
    gap: 1.5rem 4rem;
    margin-bottom: clamp(2.5rem, 2rem + 2.5vw, 4.5rem);
  }

  .practice-preview__head .title {
    max-width: 17ch;
  }

  @media (min-width: 64em) {
    .practice-preview__head {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: end;
    }
  }

  .practice-preview__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    margin-top: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  .practice-preview__note {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.25rem;
    line-height: 1.4;
    color: var(--ink);
  }

  .practice-preview__note .link {
    font-family: var(--font-sans);
    font-style: normal;
    font-size: 0.9375rem;
    margin-left: 0.35rem;
  }

  .practice-preview__note-rule {
    flex: none;
    width: 1.75rem;
    height: 1px;
    background: var(--brass);
    transform: translateY(-0.3em);
  }
</style>
